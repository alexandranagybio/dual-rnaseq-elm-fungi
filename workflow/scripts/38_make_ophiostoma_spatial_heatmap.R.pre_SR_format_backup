#!/usr/bin/env Rscript

suppressPackageStartupMessages({
  library(DESeq2)
  library(readr)
  library(dplyr)
  library(tidyr)
  library(tibble)
  library(ComplexHeatmap)
  library(circlize)
  library(grid)
  library(ltc)
})

# ==========================================================================
# Configuration
# ==========================================================================

dds_path <- file.path(
  "results",
  "ophiostoma",
  "deseq2_results",
  "objects",
  "ophiostoma_dds_deseq2_fitted.rds"
)

de_dir <- file.path(
  "results",
  "ophiostoma",
  "deseq2_results",
  "tables"
)

contrast_paths <- c(
  interaction_vs_self = file.path(
    de_dir,
    "interaction_vs_self_lfcshrunk.tsv"
  ),
  interaction_vs_onu = file.path(
    de_dir,
    "interaction_vs_onu_lfcshrunk.tsv"
  ),
  onu_vs_self = file.path(
    de_dir,
    "onu_vs_self_lfcshrunk.tsv"
  )
)

output_dir <- file.path(
  "figures",
  "figure6_ophiostoma_spatial_response"
)

table_dir <- file.path(
  "results",
  "publication",
  "ophiostoma_spatial_heatmap"
)

dir.create(
  output_dir,
  recursive = TRUE,
  showWarnings = FALSE
)

dir.create(
  table_dir,
  recursive = TRUE,
  showWarnings = FALSE
)

output_pdf <- file.path(
  output_dir,
  "Figure6_Ophiostoma_spatial_response_heatmap.pdf"
)

output_png <- file.path(
  output_dir,
  "Figure6_Ophiostoma_spatial_response_heatmap.png"
)

selected_table_path <- file.path(
  table_dir,
  "ophiostoma_spatial_heatmap_selected_genes.tsv"
)

classification_table_path <- file.path(
  table_dir,
  "ophiostoma_spatial_response_classification_all.tsv"
)

matrix_path <- file.path(
  table_dir,
  "ophiostoma_spatial_heatmap_zscores.tsv"
)

summary_path <- file.path(
  table_dir,
  "ophiostoma_spatial_response_summary.tsv"
)

sample_metadata_path <- file.path(
  table_dir,
  "ophiostoma_spatial_heatmap_sample_metadata.tsv"
)

run_info_path <- file.path(
  table_dir,
  "run_info.tsv"
)

alpha_threshold <- 0.05

# Row Z-scores are clipped symmetrically.
zscore_limit <- 2.0

# Maximum number of genes retained per biological response program.
target_rows <- c(
  "Reaction-zone specific" = 60,
  "Plate-wide confrontation response" = 60,
  "Complex spatial response" = 60,
  "Non-contact-region specific" = 30
)

group_order <- names(target_rows)

condition_order <- c(
  "Non-contact",
  "Control",
  "Reaction zone"
)

# ==========================================================================
# Input validation
# ==========================================================================

if (!file.exists(dds_path)) {
  stop(
    "Missing fitted Ophiostoma DESeq2 object: ",
    dds_path
  )
}

missing_contrast_files <- contrast_paths[
  !file.exists(contrast_paths)
]

if (length(missing_contrast_files) > 0) {
  stop(
    "Missing contrast tables:\n",
    paste(
      missing_contrast_files,
      collapse = "\n"
    )
  )
}

dds <- readRDS(dds_path)

if (!inherits(dds, "DESeqDataSet")) {
  stop(
    "Input object is not a DESeqDataSet: ",
    dds_path
  )
}

if (!"condition" %in% names(colData(dds))) {
  stop(
    "The DESeqDataSet lacks colData(dds)$condition."
  )
}

condition_raw <- as.character(
  colData(dds)$condition
)

required_conditions <- c(
  "self",
  "onu",
  "interaction"
)

missing_conditions <- setdiff(
  required_conditions,
  unique(condition_raw)
)

if (length(missing_conditions) > 0) {
  stop(
    "Missing expected conditions: ",
    paste(
      missing_conditions,
      collapse = ", "
    ),
    "\nObserved conditions: ",
    paste(
      sort(unique(condition_raw)),
      collapse = ", "
    )
  )
}

# ==========================================================================
# Read pairwise contrast tables
# ==========================================================================

read_contrast <- function(
    contrast_name,
    path
) {
  table <- read_tsv(
    path,
    show_col_types = FALSE,
    progress = FALSE
  )

  required_columns <- c(
    "gene_id",
    "padj",
    "shrunk_log2FoldChange"
  )

  missing_columns <- setdiff(
    required_columns,
    names(table)
  )

  if (length(missing_columns) > 0) {
    stop(
      contrast_name,
      " is missing columns: ",
      paste(
        missing_columns,
        collapse = ", "
      )
    )
  }

  if (anyDuplicated(table$gene_id) > 0) {
    stop(
      contrast_name,
      " contains duplicated gene IDs."
    )
  }

  table %>%
    transmute(
      gene_id,
      !!paste0(
        contrast_name,
        "_padj"
      ) := padj,
      !!paste0(
        contrast_name,
        "_lfc"
      ) := shrunk_log2FoldChange
    )
}

contrast_tables <- Map(
  read_contrast,
  names(contrast_paths),
  contrast_paths
)

de <- Reduce(
  function(x, y) {
    full_join(
      x,
      y,
      by = "gene_id"
    )
  },
  contrast_tables
)

# ==========================================================================
# Define Ophiostoma transcriptional response programs
#
# Internal DESeq2 condition names originate from the original workflow:
#
#   interaction = reaction zone of the confrontation plate
#   self        = non-contact region of the confrontation plate
#   onu         = Ophiostoma self-control colony
#
# Contrast orientations:
#
# interaction_vs_self
#   positive: reaction zone > non-contact region
#
# interaction_vs_onu
#   positive: reaction zone > control colony
#
# onu_vs_self
#   positive: control colony > non-contact region
#
# Publication-facing interpretation must use the biological labels above,
# not the internal condition names.
# ==========================================================================

de <- de %>%
  mutate(
    sig_reaction_vs_noncontact =
      !is.na(interaction_vs_self_padj) &
      interaction_vs_self_padj < alpha_threshold,

    sig_reaction_vs_control =
      !is.na(interaction_vs_onu_padj) &
      interaction_vs_onu_padj < alpha_threshold,

    sig_control_vs_noncontact =
      !is.na(onu_vs_self_padj) &
      onu_vs_self_padj < alpha_threshold,

    sign_reaction_vs_noncontact =
      sign(interaction_vs_self_lfc),

    sign_reaction_vs_control =
      sign(interaction_vs_onu_lfc),

    sign_control_vs_noncontact =
      sign(onu_vs_self_lfc),

    n_significant =
      as.integer(sig_reaction_vs_noncontact) +
      as.integer(sig_reaction_vs_control) +
      as.integer(sig_control_vs_noncontact),

    # Reaction zone differs from both the non-contact region and control,
    # whereas the non-contact region does not differ from control.
    is_reaction_specific =
      sig_reaction_vs_noncontact &
      sig_reaction_vs_control &
      !sig_control_vs_noncontact &
      sign_reaction_vs_noncontact != 0 &
      sign_reaction_vs_noncontact ==
        sign_reaction_vs_control,

    # Non-contact region differs from both the reaction zone and control,
    # whereas the reaction zone does not differ from control.
    is_noncontact_specific =
      sig_reaction_vs_noncontact &
      sig_control_vs_noncontact &
      !sig_reaction_vs_control &
      sign_reaction_vs_noncontact != 0 &
      sign_reaction_vs_noncontact ==
        sign_control_vs_noncontact,

    # Both sampled regions of the confrontation plate differ from the
    # self-control colony in the same direction, while the two plate regions
    # do not differ significantly from one another.
    #
    # Because onu_vs_self is CONTROL minus NON-CONTACT,
    # its sign must be reversed when comparing NON-CONTACT minus CONTROL.
    is_plate_wide =
      !sig_reaction_vs_noncontact &
      sig_reaction_vs_control &
      sig_control_vs_noncontact &
      sign_reaction_vs_control != 0 &
      sign_reaction_vs_control ==
        -sign_control_vs_noncontact,

    # Remaining genes with evidence in at least two pairwise contrasts.
    is_complex =
      n_significant >= 2 &
      !is_reaction_specific &
      !is_noncontact_specific &
      !is_plate_wide
  ) %>%
  mutate(
    response_group = case_when(
      is_reaction_specific ~
        "Reaction-zone specific",

      is_noncontact_specific ~
        "Non-contact-region specific",

      is_plate_wide ~
        "Plate-wide confrontation response",

      is_complex ~
        "Complex spatial response",

      TRUE ~ NA_character_
    )
  )

# ==========================================================================
# VST expression matrix
# ==========================================================================

vst_object <- vst(
  dds,
  blind = FALSE
)

vst_matrix <- assay(
  vst_object
)

if (anyDuplicated(
  rownames(vst_matrix)
) > 0) {
  stop(
    "Duplicated gene IDs detected in the VST matrix."
  )
}

# ==========================================================================
# Sample metadata and fixed biological column order
# ==========================================================================

sample_metadata <- as.data.frame(
  colData(dds)
) %>%
  rownames_to_column(
    "sample_id"
  ) %>%
  mutate(
    condition_raw = as.character(
      condition
    ),

    condition_display = recode(
      condition_raw,
      self = "Non-contact",
      onu = "Control",
      interaction = "Reaction zone"
    ),

    condition_display = factor(
      condition_display,
      levels = condition_order
    )
  ) %>%
  arrange(
    condition_display,
    sample_id
  ) %>%
  group_by(
    condition_display
  ) %>%
  mutate(
    replicate_number = row_number(),
    replicate_label = paste0(
      "R",
      replicate_number
    )
  ) %>%
  ungroup()

sample_order <- sample_metadata$sample_id

missing_vst_samples <- setdiff(
  sample_order,
  colnames(vst_matrix)
)

if (length(missing_vst_samples) > 0) {
  stop(
    "Samples absent from VST matrix: ",
    paste(
      missing_vst_samples,
      collapse = ", "
    )
  )
}

vst_matrix <- vst_matrix[
  ,
  sample_order,
  drop = FALSE
]

write_tsv(
  sample_metadata,
  sample_metadata_path
)

# ==========================================================================
# Condition means
# ==========================================================================

condition_means <- sapply(
  condition_order,
  function(condition_name) {
    relevant_samples <- sample_metadata %>%
      filter(
        condition_display == condition_name
      ) %>%
      pull(
        sample_id
      )

    rowMeans(
      vst_matrix[
        ,
        relevant_samples,
        drop = FALSE
      ]
    )
  }
)

condition_means <- as.data.frame(
  condition_means
) %>%
  rownames_to_column(
    "gene_id"
  )

names(condition_means)[-1] <- c(
  "mean_noncontact",
  "mean_control",
  "mean_reaction"
)

# ==========================================================================
# Rank genes within response programs
# ==========================================================================

de <- de %>%
  left_join(
    condition_means,
    by = "gene_id"
  ) %>%
  mutate(
    expression_range = pmax(
      mean_noncontact,
      mean_control,
      mean_reaction,
      na.rm = TRUE
    ) -
      pmin(
        mean_noncontact,
        mean_control,
        mean_reaction,
        na.rm = TRUE
      ),

    minimum_relevant_padj = pmin(
      interaction_vs_self_padj,
      interaction_vs_onu_padj,
      onu_vs_self_padj,
      na.rm = TRUE
    ),

    minimum_relevant_padj = if_else(
      is.infinite(
        minimum_relevant_padj
      ),
      NA_real_,
      minimum_relevant_padj
    ),

    significance_score = pmin(
      -log10(
        pmax(
          minimum_relevant_padj,
          1e-300
        )
      ),
      300
    ),

    maximum_abs_lfc = pmax(
      abs(interaction_vs_self_lfc),
      abs(interaction_vs_onu_lfc),
      abs(onu_vs_self_lfc),
      na.rm = TRUE
    ),

    selection_score =
      significance_score +
      2 * maximum_abs_lfc +
      expression_range
  )

classified <- de %>%
  filter(
    !is.na(response_group),
    gene_id %in% rownames(vst_matrix)
  ) %>%
  mutate(
    response_group = factor(
      response_group,
      levels = group_order
    )
  )

selected <- bind_rows(
  lapply(
    group_order,
    function(group_name) {
      classified %>%
        filter(
          response_group == group_name
        ) %>%
        arrange(
          desc(selection_score),
          minimum_relevant_padj,
          gene_id
        ) %>%
        slice_head(
          n = target_rows[[group_name]]
        )
    }
  )
)

if (nrow(selected) == 0) {
  stop(
    "No genes passed the spatial-response classification."
  )
}

if (anyDuplicated(
  selected$gene_id
) > 0) {
  stop(
    "One or more genes were selected more than once."
  )
}

# ==========================================================================
# Row-scaled expression matrix
# ==========================================================================

heatmap_matrix <- vst_matrix[
  selected$gene_id,
  ,
  drop = FALSE
]

row_zscore <- t(
  scale(
    t(heatmap_matrix)
  )
)

# Genes with zero variance would yield NA after scaling.
row_zscore[
  is.na(row_zscore)
] <- 0

row_zscore <- pmax(
  pmin(
    row_zscore,
    zscore_limit
  ),
  -zscore_limit
)

selected <- selected %>%
  arrange(
    response_group
  )

row_zscore <- row_zscore[
  selected$gene_id,
  ,
  drop = FALSE
]

row_split <- factor(
  selected$response_group,
  levels = group_order
)

column_split <- factor(
  sample_metadata$condition_display,
  levels = condition_order
)

column_labels <- sample_metadata$replicate_label

# ==========================================================================
# Save audit and source tables
# ==========================================================================

classification_output <- de %>%
  select(
    gene_id,
    response_group,
    interaction_vs_self_padj,
    interaction_vs_self_lfc,
    interaction_vs_onu_padj,
    interaction_vs_onu_lfc,
    onu_vs_self_padj,
    onu_vs_self_lfc,
    sig_reaction_vs_noncontact,
    sig_reaction_vs_control,
    sig_control_vs_noncontact,
    n_significant,
    mean_noncontact,
    mean_control,
    mean_reaction,
    expression_range,
    maximum_abs_lfc,
    minimum_relevant_padj,
    significance_score,
    selection_score
  )

write_tsv(
  classification_output,
  classification_table_path
)

selected_output <- selected %>%
  group_by(
    response_group
  ) %>%
  arrange(
    desc(selection_score),
    .by_group = TRUE
  ) %>%
  mutate(
    selected_rank_within_group = row_number()
  ) %>%
  ungroup()

write_tsv(
  selected_output,
  selected_table_path
)

write_tsv(
  as.data.frame(
    row_zscore
  ) %>%
    rownames_to_column(
      "gene_id"
    ),
  matrix_path
)

summary_table <- classified %>%
  count(
    response_group,
    name = "available_genes"
  ) %>%
  complete(
    response_group = factor(
      group_order,
      levels = group_order
    ),
    fill = list(
      available_genes = 0
    )
  ) %>%
  left_join(
    selected %>%
      count(
        response_group,
        name = "selected_genes"
      ),
    by = "response_group"
  ) %>%
  mutate(
    selected_genes = replace_na(
      selected_genes,
      0
    )
  )

write_tsv(
  summary_table,
  summary_path
)

# ==========================================================================
# Annotations
# ==========================================================================

condition_colours <- c(
  "Non-contact" = "#718E73",
  "Control" = "#8A74A3",
  "Reaction zone" = "#B55A50"
)

group_colours <- c(
  "Reaction-zone specific" = "#B55A50",
  "Plate-wide confrontation response" = "#567DA0",
  "Complex spatial response" = "#4F908B",
  "Non-contact-region specific" = "#8B8B8B"
)

column_condition <- sample_metadata$condition_display

names(
  column_condition
) <- sample_metadata$sample_id

top_annotation <- HeatmapAnnotation(
  Condition = column_condition,

  col = list(
    Condition = condition_colours
  ),

  show_annotation_name = FALSE,
  show_legend = FALSE,

  simple_anno_size = unit(
    3.4,
    "mm"
  )
)

left_annotation <- rowAnnotation(
  Program = row_split,

  col = list(
    Program = group_colours
  ),

  show_annotation_name = FALSE,
  show_legend = FALSE,

  width = unit(
    3.4,
    "mm"
  )
)

# ==========================================================================
# LTC palettes
#
# Use the complete continuous palettes rather than reducing each palette
# to three anchor colours.
# ==========================================================================

heatmap_palette_name <- "heatmap1"

heatmap_palette_colours <- as.character(
  ltc(
    heatmap1,
    n = 101,
    type = "continuous"
  )
)

heatmap_colour_function <- colorRamp2(
  seq(
    -zscore_limit,
    zscore_limit,
    length.out = length(
      heatmap_palette_colours
    )
  ),
  heatmap_palette_colours
)

# ==========================================================================
# Build one heatmap using a supplied colour function
# ==========================================================================

build_heatmap <- function() {
  Heatmap(
    row_zscore,

    name = "Row Z-score",
    col = heatmap_colour_function,

    top_annotation = top_annotation,
    left_annotation = left_annotation,

    row_split = row_split,
    column_split = column_split,

    cluster_rows = TRUE,
    cluster_row_slices = FALSE,

    cluster_columns = FALSE,
    cluster_column_slices = FALSE,

    show_row_dend = FALSE,
    show_column_dend = FALSE,

    show_row_names = FALSE,
    show_column_names = TRUE,

    column_labels = column_labels,

    column_title = condition_order,

    column_title_gp = gpar(
      fontsize = 9,
      fontface = "bold",
      col = "grey15"
    ),

    column_names_gp = gpar(
      fontsize = 8,
      col = "grey20"
    ),

    column_names_rot = 0,

    row_title_rot = 0,

    row_title_gp = gpar(
      fontsize = 8,
      fontface = "bold",
      col = "grey15"
    ),

    row_title_side = "left",

    row_gap = unit(
      2.8,
      "mm"
    ),

    column_gap = unit(
      2.4,
      "mm"
    ),

    border = FALSE,

    rect_gp = gpar(
      col = NA
    ),

    use_raster = TRUE,
    raster_quality = 5,

    heatmap_legend_param = list(
      title = "Row Z-score",

      title_gp = gpar(
        fontsize = 9,
        fontface = "bold"
      ),

      labels_gp = gpar(
        fontsize = 8
      ),

      direction = "horizontal",

      legend_width = unit(
        38,
        "mm"
      ),

      at = c(
        -2,
        -1,
        0,
        1,
        2
      )
    )
  )
}

# ==========================================================================
# Draw and export
# ==========================================================================

draw_heatmap <- function(
    heatmap_object
) {
  draw(
    heatmap_object,

    heatmap_legend_side = "bottom",
    annotation_legend_side = "bottom",

    merge_legends = TRUE,

    padding = unit(
      c(
        4,
        4,
        4,
        4
      ),
      "mm"
    )
  )
}

message(
  "Rendering final LTC palette: ",
  heatmap_palette_name
)

heatmap_object <- build_heatmap()

cairo_pdf(
  filename = output_pdf,
  width = 7.6,
  height = 8.5,
  family = "sans"
)

draw_heatmap(
  heatmap_object
)

dev.off()

png(
  filename = output_png,
  width = 7.6,
  height = 8.5,
  units = "in",
  res = 600,
  type = "cairo",
  bg = "white"
)

draw_heatmap(
  heatmap_object
)

dev.off()

# ==========================================================================
# Run information
# ==========================================================================

run_info <- tibble(
  field = c(
    "script",
    "run_timestamp",
    "dds_file",
    "alpha_threshold",
    "zscore_limit",
    "selected_gene_count",
    "column_order",
    "row_program_order",
    "row_clustering",
    "column_clustering",
    "heatmap_palette",
    "palette_generation",
    "response_program_display_labels",
    "selected_rows_per_program"
  ),

  value = c(
    "38_make_ophiostoma_spatial_heatmap.R",
    format(
      Sys.time(),
      tz = "UTC",
      usetz = TRUE
    ),
    dds_path,
    as.character(
      alpha_threshold
    ),
    as.character(
      zscore_limit
    ),
    as.character(
      nrow(selected)
    ),
    paste(
      condition_order,
      collapse = " | "
    ),
    paste(
      group_order,
      collapse = " | "
    ),
    "hierarchical clustering within response programs",
    "none; fixed Non-contact -> Control -> Reaction zone order",
    "ltc::heatmap1",
    "ltc(name, n = 101, type = continuous)",
    paste(
      group_order,
      collapse = " | "
    ),
    paste(
      names(target_rows),
      target_rows,
      sep = "=",
      collapse = " | "
    )
  )
)

write_tsv(
  run_info,
  run_info_path
)

# ==========================================================================
# Console report
# ==========================================================================

cat("\n")
cat("============================================================\n")
cat("OPHIOSTOMA SPATIAL HEATMAPS COMPLETE\n")
cat("============================================================\n\n")

cat(
  "Selected genes: ",
  nrow(selected),
  "\n\n",
  sep = ""
)

print(
  summary_table,
  n = Inf,
  width = Inf
)

cat("\nFinal heatmap:\n")
cat(
  "  Palette: ltc::",
  heatmap_palette_name,
  "\n",
  sep = ""
)
cat(
  "  PDF: ",
  output_pdf,
  "\n",
  sep = ""
)
cat(
  "  PNG: ",
  output_png,
  "\n",
  sep = ""
)

cat("\nSupporting tables:\n")
cat(
  "  Classification: ",
  classification_table_path,
  "\n",
  sep = ""
)
cat(
  "  Selected genes: ",
  selected_table_path,
  "\n",
  sep = ""
)
cat(
  "  Z-score matrix: ",
  matrix_path,
  "\n",
  sep = ""
)
cat(
  "  Summary: ",
  summary_path,
  "\n",
  sep = ""
)
cat(
  "  Metadata: ",
  sample_metadata_path,
  "\n",
  sep = ""
)
cat(
  "  Run info: ",
  run_info_path,
  "\n",
  sep = ""
)
