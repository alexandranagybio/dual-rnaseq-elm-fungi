#!/usr/bin/env Rscript

suppressPackageStartupMessages({
  library(readr)
  library(dplyr)
  library(ggplot2)
  library(patchwork)
  library(grid)
})

# ==========================================================================
# Final manuscript Figure 4
# A — within-species COG enrichment landscape
# B — species × COG interaction forest plot
#
# Visualization only: NO statistical analysis is performed here.
# ==========================================================================

enrichment_file <- file.path(
  "results/publication/cog_enrichment",
  "cog_enrichment_significant.tsv"
)

interaction_file <- file.path(
  "results/publication/cog_species_interaction",
  "species_cog_interaction_significant.tsv"
)

output_dir <- file.path(
  "figures/publication/final"
)

dir.create(
  output_dir,
  recursive = TRUE,
  showWarnings = FALSE
)

fusarium_colour <- "#D9792B"
ophiostoma_colour <- "#76519D"

species_colours <- c(
  Fusarium = fusarium_colour,
  Ophiostoma = ophiostoma_colour
)

# ==========================================================================
# Publication-facing labels
# ==========================================================================

short_names <- c(
  "Carbohydrate transport and metabolism" =
    "Carbohydrate metabolism",
  "Translation and ribosome biogenesis" =
    "Translation",
  "Energy production and conversion" =
    "Energy production",
  "Amino-acid transport and metabolism" =
    "Amino-acid metabolism",
  "Coenzyme transport and metabolism" =
    "Coenzyme metabolism",
  "Lipid transport and metabolism" =
    "Lipid metabolism",
  "Post-translational modification and protein turnover" =
    "Protein turnover",
  "Cytoskeleton" =
    "Cytoskeleton",
  "Intracellular trafficking and secretion" =
    "Intracellular trafficking",
  "Transcription" =
    "Transcription",
  "Chromatin structure and dynamics" =
    "Chromatin",
  "Inorganic-ion transport and metabolism" =
    "Ion transport",
  "Secondary-metabolite biosynthesis and transport" =
    "Secondary metabolism",
  "RNA processing and modification" =
    "RNA processing",
  "Function unknown" =
    "Function unknown"
)

shorten_cog <- function(x) {
  out <- unname(short_names[x])
  missing <- is.na(out)
  out[missing] <- x[missing]
  out
}

# ==========================================================================
# PANEL A
# ==========================================================================

enrichment <- read_tsv(
  enrichment_file,
  show_col_types = FALSE
) %>%
  mutate(
    label = shorten_cog(cog_name),

    log2_or = log2(odds_ratio),

    column_key = paste(
      organism,
      direction,
      sep = "__"
    ),

    response_x = case_when(
      column_key == "Fusarium__Induced" ~ 1.00,
      column_key == "Ophiostoma__Induced" ~ 1.75,
      column_key == "Fusarium__Repressed" ~ 3.25,
      column_key == "Ophiostoma__Repressed" ~ 4.00,
      TRUE ~ NA_real_
    )
  )

category_order <- c(
  "Translation",
  "RNA processing",
  "Transcription",
  "Chromatin",
  "Protein turnover",
  "Intracellular trafficking",
  "Cytoskeleton",
  "Energy production",
  "Lipid metabolism",
  "Carbohydrate metabolism",
  "Amino-acid metabolism",
  "Coenzyme metabolism",
  "Ion transport",
  "Secondary metabolism",
  "Function unknown"
)

observed <- unique(enrichment$label)

category_order <- c(
  category_order[
    category_order %in% observed
  ],
  setdiff(
    observed,
    category_order
  )
)

enrichment <- enrichment %>%
  mutate(
    label = factor(
      label,
      levels = rev(category_order)
    )
  )


panel_a <- ggplot(
  enrichment,
  aes(
    x = response_x,
    y = label
  )
) +
  geom_hline(
    yintercept = seq_along(category_order),
    colour = "#EEEEEE",
    linewidth = 0.36
  ) +
  geom_point(
    aes(
      size = log2_or,
      fill = organism
    ),
    shape = 21,
    colour = "#333333",
    stroke = 0.36
  ) +
  scale_x_continuous(
    breaks = c(
      1.375,
      3.625
    ),
    labels = c(
      "Induced",
      "Repressed"
    ),
    limits = c(
      0.45,
      4.55
    ),
    expand = expansion(
      mult = c(
        0,
        0
      )
    ),
    position = "top"
  ) +
  scale_fill_manual(
    values = species_colours,
    breaks = c(
      "Fusarium",
      "Ophiostoma"
    ),
    labels = c(
      expression(
        italic("F.")~"cf."~italic("salinense")
      ),
      expression(
        italic("O. novo-ulmi")
      )
    ),
    name = NULL
  ) +
  scale_size_continuous(
    name = expression(
      log[2]~"enrichment odds ratio"
    ),
    range = c(
      3,
      8
    )
  ) +
  guides(
    size = guide_legend(
      order = 1
    ),
    fill = guide_legend(
      order = 2,
      override.aes = list(
        size = 4
      )
    )
  ) +
  coord_cartesian(
    clip = "off"
  ) +
  labs(
    x = NULL,
    y = NULL,
    tag = "a"
  ) +
  theme_classic(
    base_size = 10,
    base_family = "Nimbus Sans"
  ) +
  theme(
    axis.text.x = element_text(
      size = 9.5,
      face = "bold",
      margin = margin(
        b = 9
      )
    ),

    axis.text.y = element_text(
      size = 9
    ),

    axis.ticks = element_blank(),
    axis.line = element_blank(),

    legend.position = "right",
    legend.box = "vertical",

    legend.spacing.y = unit(
      2,
      "mm"
    ),

    legend.title = element_text(
      size = 8.5
    ),

    legend.text = element_text(
      size = 8.5
    ),

    plot.tag = element_text(
      face = "bold",
      size = 10
    ),

    plot.tag.position = c(
      0.01,
      0.99
    ),

    plot.margin = margin(
      12,
      10,
      4,
      8
    )
  )


# ==========================================================================
# PANEL B
# ==========================================================================

interaction <- read_tsv(
  interaction_file,
  show_col_types = FALSE
)

biology_order <- c(
  "Energy production",
  "Lipid metabolism",
  "Ion transport",
  "Coenzyme metabolism",
  "Translation",
  "Transcription",
  "RNA processing",
  "Chromatin",
  "Protein turnover",
  "Intracellular trafficking",
  "Cytoskeleton"
)

interaction_plot <- interaction %>%
  mutate(
    label = shorten_cog(cog_name),

    response = factor(
      response,
      levels = c(
        "Induced",
        "Repressed"
      )
    ),

    log2_interaction =
      log2(interaction_odds_ratio),

    log2_ci_lower =
      log2(interaction_ci_lower),

    log2_ci_upper =
      log2(interaction_ci_upper),

    supported_in = case_when(
      interaction_odds_ratio < 1 ~
        "Fusarium",

      interaction_odds_ratio > 1 ~
        "Ophiostoma",

      TRUE ~
        NA_character_
    )
  ) %>%
  filter(
    label %in% biology_order
  ) %>%
  mutate(
    label = factor(
      label,
      levels = rev(biology_order)
    )
  )

interaction_limit <- max(
  abs(
    c(
      interaction_plot$log2_ci_lower,
      interaction_plot$log2_ci_upper
    )
  ),
  na.rm = TRUE
)

interaction_limit <- ceiling(
  interaction_limit * 2
) / 2


make_interaction_panel <- function(
    data,
    response_name,
    show_x_axis = FALSE,
    panel_tag = NULL) {

  p <- data %>%
    filter(
      response == response_name
    ) %>%
    ggplot(
      aes(
        x = log2_interaction,
        y = label
      )
    ) +
    geom_vline(
      xintercept = 0,
      linewidth = 0.45,
      linetype = "dashed",
      colour = "grey75"
    ) +
    geom_errorbar(
      aes(
        xmin = log2_ci_lower,
        xmax = log2_ci_upper,
        colour = supported_in
      ),
      orientation = "y",
      width = 0,
      linewidth = 0.70
    ) +
    geom_point(
      aes(
        colour = supported_in
      ),
      size = 3
    ) +
    annotate(
      "text",
      x = 0,
      y = Inf,
      label = response_name,
      fontface = "bold",
      family = "Nimbus Sans",
      size = 3.35,
      vjust = -0.75
    ) +
    scale_colour_manual(
      values = species_colours,
      guide = "none"
    ) +
    scale_x_continuous(
      limits = c(
        -interaction_limit,
        interaction_limit
      ),
      expand = expansion(
        mult = c(
          0.035,
          0.035
        )
      )
    ) +
    coord_cartesian(
      clip = "off"
    ) +
    labs(
      x = if (show_x_axis) {
        expression(
          log[2]~
          "species × COG interaction odds ratio"
        )
      } else {
        NULL
      },
      y = NULL,
      tag = panel_tag
    ) +
    theme_classic(
      base_size = 10,
      base_family = "Nimbus Sans"
    ) +
    theme(
      axis.text.y = element_text(
        size = 9
      ),

      axis.text.x = element_text(
        size = 9
      ),

      axis.ticks.y = element_blank(),
      axis.line.y = element_blank(),

      legend.position = "none",

      plot.tag = element_text(
        face = "bold",
        size = 10
      ),

      plot.tag.position = c(
        -0.035,
        1.05
      ),

      plot.margin = margin(
        8,
        5,
        2,
        8
      )
    )

  if (!show_x_axis) {
    p <- p +
      theme(
        axis.text.x = element_blank(),
        axis.ticks.x = element_blank(),
        axis.line.x = element_blank()
      )
  }

  p
}


panel_b_induced <- make_interaction_panel(
  data = interaction_plot,
  response_name = "Induced",
  show_x_axis = FALSE,
  panel_tag = "b"
)

panel_b_repressed <- make_interaction_panel(
  data = interaction_plot,
  response_name = "Repressed",
  show_x_axis = TRUE,
  panel_tag = NULL
)

panel_b <- (
  panel_b_induced /
    panel_b_repressed
) +
  plot_layout(
    heights = c(
      1.04,
      0.96
    )
  )


# ==========================================================================
# FINAL LAYOUT
# ==========================================================================

final_figure <- (
  panel_a /
    wrap_elements(
      full = panel_b
    )
) +
  plot_layout(
    heights = c(
      0.88,
      1.25
    )
  )


ggsave(
  file.path(
    output_dir,
    "Figure4_functional_organization.pdf"
  ),
  final_figure,
  width = 180,
  height = 218,
  units = "mm",
  device = cairo_pdf,
  bg = "white"
)

ggsave(
  file.path(
    output_dir,
    "Figure4_functional_organization.png"
  ),
  final_figure,
  width = 180,
  height = 218,
  units = "mm",
  dpi = 600,
  bg = "white"
)

message("")
message("==============================================")
message("FINAL FIGURE 4 COMPLETE")
message("==============================================")
message("")
message(
  "figures/publication/final/",
  "Figure4_functional_organization.pdf"
)
message("")
message("PASS: visualization only; no re-analysis.")
