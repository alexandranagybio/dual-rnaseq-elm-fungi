#!/usr/bin/env Rscript

suppressPackageStartupMessages({
  library(readr)
  library(dplyr)
  library(ggplot2)
  library(patchwork)
  library(grid)
})

# ==========================================================================
# Final manuscript Figure 4
# A — within-species COG enrichment landscape
# B — species × COG interaction forest plot
#
# Visualization only: NO statistical analysis is performed here.
# ==========================================================================

enrichment_file <- file.path(
  "results/publication/cog_enrichment",
  "cog_enrichment_significant.tsv"
)

interaction_file <- file.path(
  "results/publication/cog_species_interaction",
  "species_cog_interaction_significant.tsv"
)

output_dir <- file.path(
  "figures/publication/final"
)

dir.create(
  output_dir,
  recursive = TRUE,
  showWarnings = FALSE
)

fusarium_colour <- "#D9792B"
ophiostoma_colour <- "#76519D"

species_colours <- c(
  Fusarium = fusarium_colour,
  Ophiostoma = ophiostoma_colour
)

# ==========================================================================
# Publication-facing labels
# ==========================================================================

short_names <- c(
  "Carbohydrate transport and metabolism" =
    "Carbohydrate metabolism",
  "Translation and ribosome biogenesis" =
    "Translation",
  "Energy production and conversion" =
    "Energy production",
  "Amino-acid transport and metabolism" =
    "Amino-acid metabolism",
  "Coenzyme transport and metabolism" =
    "Coenzyme metabolism",
  "Lipid transport and metabolism" =
    "Lipid metabolism",
  "Post-translational modification and protein turnover" =
    "Protein turnover",
  "Cytoskeleton" =
    "Cytoskeleton",
  "Intracellular trafficking and secretion" =
    "Intracellular trafficking",
  "Transcription" =
    "Transcription",
  "Chromatin structure and dynamics" =
    "Chromatin",
  "Inorganic-ion transport and metabolism" =
    "Ion transport",
  "Secondary-metabolite biosynthesis and transport" =
    "Secondary metabolism",
  "RNA processing and modification" =
    "RNA processing",
  "Function unknown" =
    "Function unknown"
)

shorten_cog <- function(x) {
  out <- unname(short_names[x])
  missing <- is.na(out)
  out[missing] <- x[missing]
  out
}

# ==========================================================================
# PANEL A
# ==========================================================================

enrichment <- read_tsv(
  enrichment_file,
  show_col_types = FALSE
) %>%
  mutate(
    label = shorten_cog(cog_name),

    column = paste(
      organism,
      direction,
      sep = "__"
    ),

    log2_or = log2(odds_ratio)
  )

column_order <- c(
  "Fusarium__Induced",
  "Fusarium__Repressed",
  "Ophiostoma__Induced",
  "Ophiostoma__Repressed"
)

column_labels <- c(
  "Fusarium__Induced" =
    "Induced",
  "Fusarium__Repressed" =
    "Repressed",
  "Ophiostoma__Induced" =
    "Induced",
  "Ophiostoma__Repressed" =
    "Repressed"
)

category_order <- c(
  "Translation",
  "RNA processing",
  "Transcription",
  "Chromatin",
  "Protein turnover",
  "Intracellular trafficking",
  "Cytoskeleton",
  "Energy production",
  "Lipid metabolism",
  "Carbohydrate metabolism",
  "Amino-acid metabolism",
  "Coenzyme metabolism",
  "Ion transport",
  "Secondary metabolism",
  "Function unknown"
)

observed <- unique(enrichment$label)

category_order <- c(
  category_order[
    category_order %in% observed
  ],
  setdiff(
    observed,
    category_order
  )
)

enrichment <- enrichment %>%
  mutate(
    column = factor(
      column,
      levels = column_order
    ),

    label = factor(
      label,
      levels = rev(category_order)
    )
  )

panel_a <- ggplot(
  enrichment,
  aes(
    x = column,
    y = label
  )
) +
  geom_hline(
    yintercept = seq_along(category_order),
    colour = "#EEEEEE",
    linewidth = 0.36
  ) +
  geom_point(
    aes(
      size = log2_or,
      fill = organism
    ),
    shape = 21,
    colour = "#333333",
    stroke = 0.35
  ) +
  annotate(
    "text",
    x = 1.5,
    y = length(category_order) + 1.15,
    label = expression(italic("F.")~"cf."~italic("salinense")),
    size = 3.8
  ) +
  annotate(
    "text",
    x = 3.5,
    y = length(category_order) + 1.15,
    label = expression(italic("O. novo-ulmi")),
    size = 3.8
  ) +
  scale_x_discrete(
    labels = column_labels,
    drop = FALSE,
    position = "top"
  ) +
  scale_fill_manual(
    values = species_colours,
    guide = "none"
  ) +
  scale_size_continuous(
    name = expression(
      log[2]~"enrichment odds ratio"
    ),
    range = c(3, 8)
  ) +
  coord_cartesian(
    clip = "off"
  ) +
  labs(
    x = NULL,
    y = NULL,
    tag = "a"
  ) +
  theme_classic(
    base_size = 10,
    base_family = "Nimbus Sans"
  ) +
  theme(
    axis.text.x = element_text(
      size = 9,
      face = "plain",
      margin = margin(b = 4)
    ),

    axis.text.y = element_text(
      size = 9
    ),

    axis.ticks = element_blank(),
    axis.line = element_blank(),

    legend.position = "right",

    legend.title = element_text(
      size = 8.5
    ),

    legend.text = element_text(
      size = 8
    ),

    plot.tag = element_text(
      face = "bold",
      size = 10
    ),

    plot.margin = margin(
      20,
      15,
      5,
      8
    )
  )

# ==========================================================================
# PANEL B
# ==========================================================================

interaction <- read_tsv(
  interaction_file,
  show_col_types = FALSE
)

biology_order <- c(
  "Energy production",
  "Lipid metabolism",
  "Ion transport",
  "Coenzyme metabolism",
  "Translation",
  "Transcription",
  "RNA processing",
  "Chromatin",
  "Protein turnover",
  "Intracellular trafficking",
  "Cytoskeleton"
)

interaction_plot <- interaction %>%
  mutate(
    label = shorten_cog(cog_name),

    response = factor(
      response,
      levels = c(
        "Induced",
        "Repressed"
      )
    ),

    log2_interaction =
      log2(interaction_odds_ratio),

    log2_ci_lower =
      log2(interaction_ci_lower),

    log2_ci_upper =
      log2(interaction_ci_upper),

    supported_in = case_when(
      interaction_odds_ratio < 1 ~
        "Fusarium",

      interaction_odds_ratio > 1 ~
        "Ophiostoma",

      TRUE ~
        NA_character_
    )
  ) %>%
  filter(
    label %in% biology_order
  ) %>%
  mutate(
    label = factor(
      label,
      levels = rev(biology_order)
    )
  )

interaction_limit <- max(
  abs(
    c(
      interaction_plot$log2_ci_lower,
      interaction_plot$log2_ci_upper
    )
  ),
  na.rm = TRUE
)

interaction_limit <- ceiling(
  interaction_limit * 2
) / 2

panel_b <- ggplot(
  interaction_plot,
  aes(
    x = log2_interaction,
    y = label
  )
) +
  geom_vline(
    xintercept = 0,
    linewidth = 0.45,
    linetype = "dashed",
    colour = "grey65"
  ) +
  geom_errorbarh(
    aes(
      xmin = log2_ci_lower,
      xmax = log2_ci_upper,
      colour = supported_in
    ),
    height = 0,
    linewidth = 0.7
  ) +
  geom_point(
    aes(
      colour = supported_in
    ),
    size = 3
  ) +
  facet_wrap(
    vars(response),
    ncol = 1,
    scales = "free_y",
    strip.position = "top"
  ) +
  scale_colour_manual(
    values = species_colours,
    breaks = c(
      "Fusarium",
      "Ophiostoma"
    ),
    labels = c(
      "Stronger in Fusarium",
      "Stronger in Ophiostoma"
    ),
    name = NULL
  ) +
  scale_x_continuous(
    limits = c(
      -interaction_limit,
      interaction_limit
    ),
    expand = expansion(
      mult = c(
        0.03,
        0.03
      )
    )
  ) +
  labs(
    x = expression(
      log[2]~
      "species × COG interaction odds ratio"
    ),
    y = NULL,
    tag = "b"
  ) +
  theme_classic(
    base_size = 10,
    base_family = "Nimbus Sans"
  ) +
  theme(
    strip.background =
      element_blank(),

    strip.text.x =
      element_text(
        face = "bold",
        size = 10.5,
        hjust = 0,
        margin = margin(
          t = 5,
          b = 5
        )
      ),

    axis.text.y =
      element_text(
        size = 9
      ),

    axis.text.x =
      element_text(
        size = 9
      ),

    axis.ticks.y =
      element_blank(),

    axis.line.y =
      element_blank(),

    legend.position =
      "bottom",

    panel.spacing.y =
      unit(
        5,
        "mm"
      ),

    plot.tag =
      element_text(
        face = "bold",
        size = 10
      ),

    plot.margin =
      margin(
        5,
        10,
        5,
        8
      )
  )

# ==========================================================================
# FINAL LAYOUT
# ==========================================================================

final_figure <- panel_a / panel_b +
  plot_layout(
    heights = c(
      0.85,
      1.30
    )
  )

ggsave(
  file.path(
    output_dir,
    "Figure4_functional_organization.pdf"
  ),
  final_figure,
  width = 180,
  height = 254,
  units = "mm",
  device = cairo_pdf,
  bg = "white"
)

ggsave(
  file.path(
    output_dir,
    "Figure4_functional_organization.png"
  ),
  final_figure,
  width = 180,
  height = 254,
  units = "mm",
  dpi = 600,
  bg = "white"
)

message("")
message("==============================================")
message("FINAL FIGURE 4 COMPLETE")
message("==============================================")
message("")
message(
  "figures/publication/final/",
  "Figure4_functional_organization.pdf"
)
message("")
message("PASS: visualization only; no re-analysis.")
