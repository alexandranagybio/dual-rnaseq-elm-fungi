cat("\n")
cat("============================================================\n")
cat("SPECIES × COG INTERACTION TEST COMPLETE\n")
cat("============================================================\n")

cat("\nCOG-annotated analysis universe:\n")
print(
  background_summary,
  n = Inf,
  width = Inf
)

