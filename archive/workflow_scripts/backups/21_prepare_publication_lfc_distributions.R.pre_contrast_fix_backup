#!/usr/bin/env Rscript

# 21_prepare_publication_lfc_distributions.R
#
# Purpose:
#   Build a validated, publication-ready long table of log2 fold changes for
#   Figure 3D exploration.
#
# Outputs:
#   results/publication/figure3/figure3_lfc_all_tested.tsv
#   results/publication/figure3/figure3_lfc_significant.tsv
#   results/publication/figure3/figure3_lfc_distribution_summary.tsv
#   results/publication/figure3/figure3_lfc_input_files.tsv
#
# Run from repository root:
#   Rscript workflow/scripts/21_prepare_publication_lfc_distributions.R

suppressPackageStartupMessages({
  library(readr)
  library(dplyr)
  library(purrr)
  library(stringr)
  library(tibble)
})

repo_root <- normalizePath(".", mustWork = TRUE)
output_dir <- file.path(repo_root, "results", "publication", "figure3")
dir.create(output_dir, recursive = TRUE, showWarnings = FALSE)

# -------------------------------------------------------------------------
# Helpers
# -------------------------------------------------------------------------

normalize_name <- function(x) {
  x |>
    basename() |>
    str_to_lower() |>
    str_replace_all("[^a-z0-9]+", "_")
}

score_candidate <- function(path, organism, contrast_tokens) {
  contrast_tokens <- unlist(contrast_tokens, use.names = FALSE)

  nm <- normalize_name(path)
  score <- 0

  # Strong preference for shrunken/canonical DESeq2 result tables.
  if (str_detect(nm, "lfcshrunk|lfc_shrunk|apeglm")) score <- score + 100
  if (str_detect(nm, "deseq2")) score <- score + 20
  if (str_detect(nm, "full|results")) score <- score + 10

  # Penalize tables that are not gene-level result tables.
  if (str_detect(nm, "summary|validation|overview|annotation|significant|strong")) {
    score <- score - 100
  }
  if (str_detect(nm, "raw") && !str_detect(nm, "lfcshrunk|lfc_shrunk")) {
    score <- score - 20
  }

  for (token in contrast_tokens) {
    if (str_detect(nm, fixed(token))) score <- score + 25
  }

  if (str_detect(nm, fixed(str_to_lower(organism)))) score <- score + 5
  score
}

has_required_result_columns <- function(path) {
  first_line <- tryCatch(
    readLines(path, n = 1, warn = FALSE),
    error = function(e) character()
  )

  if (length(first_line) == 0) {
    return(FALSE)
  }

  separator <- if (str_detect(first_line, "\t")) {
    "\t"
  } else if (str_detect(first_line, ",")) {
    ","
  } else {
    return(FALSE)
  }

  columns <- str_split(first_line, fixed(separator), simplify = TRUE)
  columns <- str_to_lower(str_trim(columns))

  gene_candidates <- str_to_lower(c(
    "gene_id", "gene", "Geneid", "id", "feature_id",
    "trinity_gene_id", "...1", "X1", "rowname"
  ))

  lfc_candidates <- str_to_lower(c(
    "log2FoldChange", "log2_fold_change", "log2fc", "LFC"
  ))

  padj_candidates <- str_to_lower(c(
    "padj", "adjusted_pvalue", "adjusted_p_value",
    "FDR", "qvalue"
  ))

  has_gene <- any(columns %in% gene_candidates)
  has_lfc  <- any(columns %in% lfc_candidates)
  has_padj <- any(columns %in% padj_candidates)

  has_gene && has_lfc && has_padj
}

find_result_file <- function(search_root, organism, contrast_tokens) {
  if (!dir.exists(search_root)) {
    stop("Missing search directory: ", search_root)
  }

  candidates <- list.files(
    search_root,
    pattern = "\\.(tsv|txt|csv)$",
    recursive = TRUE,
    full.names = TRUE,
    ignore.case = TRUE
  )

  if (length(candidates) == 0) {
    stop("No tabular files found under: ", search_root)
  }

  candidates <- candidates[
    vapply(candidates, has_required_result_columns, logical(1))
  ]

  if (length(candidates) == 0) {
    stop(
      "No valid DESeq2 result tables found under: ", search_root,
      "\nA valid table must contain gene ID, log2 fold change, and padj columns."
    )
  }

  scored <- tibble(
    path = candidates,
    score = map_dbl(
      candidates,
      score_candidate,
      organism = organism,
      contrast_tokens = contrast_tokens
    )
  ) |>
    arrange(desc(score), path)

  if (scored$score[[1]] <= 0) {
    stop(
      "Could not confidently identify a result file for ",
      organism, " / ", paste(contrast_tokens, collapse = " + "),
      "\nTop candidates:\n",
      paste(head(scored$path, 10), collapse = "\n")
    )
  }

  top_score <- scored$score[[1]]
  tied <- scored |> filter(score == top_score)

  if (nrow(tied) > 1) {
    message(
      "Multiple equally scored files for ", organism, " / ",
      paste(contrast_tokens, collapse = " + "),
      ". Using:\n  ", tied$path[[1]]
    )
  }

  tied$path[[1]]
}

read_result_table <- function(path) {
  ext <- str_to_lower(tools::file_ext(path))

  if (ext == "csv") {
    read_csv(path, show_col_types = FALSE, progress = FALSE)
  } else {
    read_tsv(path, show_col_types = FALSE, progress = FALSE)
  }
}

find_column <- function(tbl, candidates, required = TRUE) {
  exact <- candidates[candidates %in% names(tbl)]
  if (length(exact) > 0) return(exact[[1]])

  lower_names <- str_to_lower(names(tbl))
  lower_candidates <- str_to_lower(candidates)
  idx <- match(lower_candidates, lower_names, nomatch = 0)
  idx <- idx[idx > 0]

  if (length(idx) > 0) return(names(tbl)[idx[[1]]])

  if (required) {
    stop(
      "Could not find any of these columns: ",
      paste(candidates, collapse = ", "),
      "\nAvailable columns: ",
      paste(names(tbl), collapse = ", ")
    )
  }

  NA_character_
}

standardize_result <- function(path, organism, contrast_id, contrast_label,
                               story, expected_tested = NA_integer_) {
  tbl <- read_result_table(path)

  gene_col <- find_column(
    tbl,
    c(
      "gene_id", "gene", "Geneid", "id", "feature_id",
      "trinity_gene_id", "...1", "X1", "rowname"
    )
  )
  lfc_col <- find_column(
    tbl,
    c("log2FoldChange", "log2_fold_change", "log2fc", "LFC")
  )
  padj_col <- find_column(
    tbl,
    c("padj", "adjusted_pvalue", "adjusted_p_value", "FDR", "qvalue")
  )
  base_mean_col <- find_column(
    tbl,
    c("baseMean", "base_mean", "mean_normalized_count"),
    required = FALSE
  )

  out <- tibble(
    organism = organism,
    contrast_id = contrast_id,
    contrast_label = contrast_label,
    story = story,
    gene_id = as.character(tbl[[gene_col]]),
    base_mean = if (!is.na(base_mean_col)) {
      suppressWarnings(as.numeric(tbl[[base_mean_col]]))
    } else {
      NA_real_
    },
    log2_fold_change = suppressWarnings(as.numeric(tbl[[lfc_col]])),
    padj = suppressWarnings(as.numeric(tbl[[padj_col]])),
    source_file = normalizePath(path, mustWork = TRUE)
  ) |>
    filter(
      !is.na(gene_id),
      gene_id != "",
      is.finite(log2_fold_change)
    ) |>
    mutate(
      tested = !is.na(padj),
      significant = tested & padj < 0.05,
      direction = case_when(
        significant & log2_fold_change > 0 ~ "Upregulated",
        significant & log2_fold_change < 0 ~ "Downregulated",
        TRUE ~ "Not significant"
      ),
      abs_log2_fold_change = abs(log2_fold_change)
    )

  if (anyDuplicated(out$gene_id) > 0) {
    duplicated_ids <- unique(out$gene_id[duplicated(out$gene_id)])
    stop(
      "Duplicate gene IDs detected in ", path, ". Examples: ",
      paste(head(duplicated_ids, 10), collapse = ", ")
    )
  }

  observed_tested <- sum(out$tested)

  if (!is.na(expected_tested) && observed_tested != expected_tested) {
    warning(
      organism, " — ", contrast_label,
      ": expected ", expected_tested,
      " statistically tested genes but found ", observed_tested,
      ". Total rows in the DESeq2 table: ", nrow(out), "."
    )
  }

  out
}

# -------------------------------------------------------------------------
# Contrast registry
# -------------------------------------------------------------------------

contrast_registry <- tribble(
  ~organism,    ~contrast_id,             ~contrast_label,              ~story,                         ~source_file,                                                                                                  ~expected_tested,
  "Fusarium",   "interaction_vs_self",    "Interaction vs control",     "Cross-species confrontation", file.path(repo_root, "results", "fusarium", "deseq2_results", "fusarium_interaction_vs_self_lfcshrunk.tsv"), 9000L,
  "Ophiostoma", "interaction_vs_self",    "Interaction vs control",     "Cross-species confrontation", file.path(repo_root, "results", "ophiostoma", "deseq2_results", "tables", "interaction_vs_self_all_genes.tsv"), 8560L,
  "Ophiostoma", "interaction_vs_outside", "Interaction vs outside",     "Ophiostoma spatial response",  file.path(repo_root, "results", "ophiostoma", "deseq2_results", "tables", "interaction_vs_onu_all_genes.tsv"),  8560L,
  "Ophiostoma", "outside_vs_self",        "Outside vs control",         "Ophiostoma spatial response",  file.path(repo_root, "results", "ophiostoma", "deseq2_results", "tables", "onu_vs_self_all_genes.tsv"),          8560L
)

missing_inputs <- contrast_registry$source_file[
  !file.exists(contrast_registry$source_file)
]

if (length(missing_inputs) > 0) {
  stop(
    "Missing canonical input file(s):\n",
    paste(missing_inputs, collapse = "\n")
  )
}

input_files <- contrast_registry


message("Selected input files:")
walk2(
  input_files$contrast_label,
  input_files$source_file,
  \(label, path) message("  ", label, " -> ", path)
)

lfc_all <- pmap_dfr(
  input_files,
  \(organism, contrast_id, contrast_label, story, source_file,
    expected_tested) {
    standardize_result(
      source_file,
      organism,
      contrast_id,
      contrast_label,
      story,
      expected_tested
    )
  }
) |>
  mutate(
    organism = factor(organism, levels = c("Fusarium", "Ophiostoma")),
    story = factor(
      story,
      levels = c("Cross-species confrontation", "Ophiostoma spatial response")
    ),
    contrast_display = case_when(
      organism == "Fusarium" & contrast_id == "interaction_vs_self" ~
        "Fusarium | Interaction vs control",
      organism == "Ophiostoma" & contrast_id == "interaction_vs_self" ~
        "Ophiostoma | Interaction vs control",
      contrast_id == "interaction_vs_outside" ~
        "Ophiostoma | Interaction vs outside",
      contrast_id == "outside_vs_self" ~
        "Ophiostoma | Outside vs control",
      TRUE ~ paste(organism, contrast_label, sep = " | ")
    )
  ) |>
  filter(tested)

lfc_significant <- lfc_all |>
  filter(significant)

summary_table <- lfc_all |>
  group_by(organism, contrast_id, contrast_label, story, source_file) |>
  summarise(
    tested_genes = n(),
    significant_genes = sum(significant),
    significant_percent = 100 * mean(significant),
    significant_down = sum(direction == "Downregulated"),
    significant_up = sum(direction == "Upregulated"),
    median_signed_lfc_significant = median(
      log2_fold_change[significant],
      na.rm = TRUE
    ),
    median_abs_lfc_significant = median(
      abs_log2_fold_change[significant],
      na.rm = TRUE
    ),
    q25_abs_lfc_significant = quantile(
      abs_log2_fold_change[significant],
      0.25,
      na.rm = TRUE,
      names = FALSE
    ),
    q75_abs_lfc_significant = quantile(
      abs_log2_fold_change[significant],
      0.75,
      na.rm = TRUE,
      names = FALSE
    ),
    proportion_significant_abs_lfc_gt_1 =
      mean(abs_log2_fold_change[significant] > 1, na.rm = TRUE),
    .groups = "drop"
  )

input_file_table <- input_files |>
  select(
    organism,
    contrast_id,
    contrast_label,
    story,
    expected_tested,
    source_file
  )

write_tsv(
  lfc_all,
  file.path(output_dir, "figure3_lfc_all_tested.tsv")
)
write_tsv(
  lfc_significant,
  file.path(output_dir, "figure3_lfc_significant.tsv")
)
write_tsv(
  summary_table,
  file.path(output_dir, "figure3_lfc_distribution_summary.tsv")
)
write_tsv(
  input_file_table,
  file.path(output_dir, "figure3_lfc_input_files.tsv")
)

message("\nDistribution summary:")
print(summary_table, n = Inf)

message("\nPASS: Figure 3 fold-change tables written to:")
message("  ", output_dir)
